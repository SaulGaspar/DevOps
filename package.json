{
  "name": "sportlike-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.27",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.20",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "test-renderer": "1.2.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:security": "jest --runInBand --runTestsByPath __tests__/securityFunctional.test.js",
    "test:coverage": "jest --runInBand --coverage",
    "test:checkout": "jest --runInBand --runTestsByPath __tests__/checkout.test.js",
    "export:android": "expo export --platform android --output-dir dist",
    "validate": "npm run lint && npm run typecheck && npm test && npx expo-doctor && npm run export:android",
    "build:apk": "npx eas-cli@latest build --platform android --profile preview",
    "build:aab": "npx eas-cli@latest build --platform android --profile production"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/app/**"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "private": true
}
