# Copia este archivo como .env y llena los valores reales.
# El archivo .env NO se sube al repositorio.
EXPO_PUBLIC_API_URL=https://sl-back.vercel.app
EXPO_PUBLIC_LOGIN_PATH=/api/login
EXPO_PUBLIC_REGISTER_PATH=/api/register
EXPO_PUBLIC_FORGOT_PASSWORD_PATH=/api/forgot-password
EXPO_PUBLIC_APP_ENV=development

# Nunca coloques contraseenas, tokens privados o llaves secretas en variables EXPO_PUBLIC_.
