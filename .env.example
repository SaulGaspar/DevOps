# Copia este archivo como .env y llena los valores reales.
# El archivo .env NO se sube al repositorio.
EXPO_PUBLIC_API_URL=https://api.ejemplo.com
EXPO_PUBLIC_LOGIN_PATH=/auth/login
EXPO_PUBLIC_REGISTER_PATH=/auth/register
EXPO_PUBLIC_FORGOT_PASSWORD_PATH=/auth/forgot-password
EXPO_PUBLIC_APP_ENV=development

# Nunca coloques contraseenas, tokens privados o llaves secretas en variables EXPO_PUBLIC_.
